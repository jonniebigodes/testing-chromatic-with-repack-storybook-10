{
  "name": "repack_v5",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true react-native run-ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true react-native run-android",
    "android:release:storybook": "cross-env STORYBOOK_ENABLED=true npx react-native webpack-bundle --entry-file index.js --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "webpackstart:nocache": "cross-env STORYBOOK_ENABLED=true npx react-native webpack-start --reset-cache",
    "android:clean": "npm run storybook:android -- --no-packager",
    "android:release": "npx react-native webpack-bundle --entry-file index.js --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "android:manual-release-configuration": "cross-env STORYBOOK_ENABLED=true npx react-native webpack-bundle --entry-file index.js --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && gradlew.bat assembleRelease",
    "chromatic:manual-release-configuration": "npx react-native webpack-bundle --entry-file index.js --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && gradlew.bat assembleRelease",
    "chromatic": "chromatic --project-token=chpt_2db484f04438db0",
    "chromatic:build-react-native": "chromatic --project-token=chpt_2db484f04438db0 -d custom-build-dir",
    "chromatic:rn-help": "chromatic react-native-build --help",
    "chromatic:dualbuild": "chromatic react-native-build",
    "chromatic:generate-manifest": "chromatic generate-manifest -o custom-build-dir",
    "chromatic:ios-release": "chromatic react-native-build --platform ios",
    "chromatic:android-release": "chromatic react-native-build --platform android",
   "chromatic:ios-release-configuration": "chromatic react-native-build --platform ios -d custom-build-dir",
    "chromatic:android-release-configuration": "chromatic react-native-build --platform android -d custom-build-dir",
    "storybook:android:release": "cross-env STORYBOOK_ENABLED=true react-native run-android --mode release"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "latest",
    "@react-native-async-storage/async-storage": "latest",
    "@react-native-community/datetimepicker": "latest",
    "@react-native-community/slider": "latest",
    "@react-native/new-app-screen": "0.87.1",
    "@storybook/addon-ondevice-actions": "latest",
    "@storybook/addon-ondevice-controls": "latest",
    "@storybook/react-native": "latest",
    "@storybook/react-native-ui-lite": "latest",
    "cross-env": "latest",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "latest",
    "react-native-reanimated": "latest",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "latest",
    "react-native-worklets": "latest",
    "storybook": "^10.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@callstack/repack": "^5.4.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@rspack/core": "^1.7.12",
    "@swc/helpers": "^0.5.23",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "chromatic": "^18.13.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
